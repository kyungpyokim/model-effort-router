#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's real location so the launcher keeps working when it is
# installed into ~/.local/bin as a symlink.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  LINK_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${LINK_DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
ROOT_DIR="${MODEL_EFFORT_ROUTER_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
ROUTER="${ROOT_DIR}/scripts/router.py"

if [[ ! -f "${ROUTER}" ]]; then
  echo "agy-route: router not found at ${ROUTER}" >&2
  echo "agy-route: set MODEL_EFFORT_ROUTER_ROOT to the bundle root directory" >&2
  exit 1
fi

INTERACTIVE=0

while [[ "${1:-}" == "--interactive" ]]; do
  INTERACTIVE=1
  shift
done
if [[ "${1:-}" == "--route-file" ]]; then
  [[ "$#" -eq 2 && "$INTERACTIVE" -eq 0 ]] || { echo "usage: agy-route --route-file <route.json>" >&2; exit 2; }
  ROUTE_ARGS=(--route-file "$2")
  COMMAND="$(python3 "${ROUTER}" "${ROUTE_ARGS[@]}")"
  if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}${MODEL_EFFORT_ROUTER_VERBOSE:-}" ]]; then echo "[model-effort-router] ${COMMAND}" >&2; fi
  if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then exit 0; fi
  exec python3 "${ROOT_DIR}/scripts/pipeline.py" --route-file "$2"
fi
if [[ "${1:-}" == "--" ]]; then
  shift
fi
if [[ "$#" -eq 0 ]]; then
  echo "usage: agy-route [--interactive] -- <task> | agy-route --route-file <route.json>" >&2
  exit 2
fi

TASK="$*"
ROUTE_FILE="$(mktemp "${TMPDIR:-/tmp}/model-effort-route.XXXXXX")"
trap 'rm -f "${ROUTE_FILE}"' EXIT
ARGS=("${ROUTER}" "${TASK}" --platform antigravity --format json)
if [[ -n "${MODEL_EFFORT_ROUTER_MODELS_FILE:-}" ]]; then
  ARGS+=(--available-models-file "${MODEL_EFFORT_ROUTER_MODELS_FILE}")
else
  ARGS+=(--detect-antigravity-models)
fi
if [[ "$INTERACTIVE" -eq 1 ]]; then
  ARGS+=(--interactive)
fi
python3 "${ARGS[@]}" > "${ROUTE_FILE}"
ROUTE_ARGS=(--route-file "${ROUTE_FILE}" --cleanup-plan-dir)
if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}${MODEL_EFFORT_ROUTER_VERBOSE:-}" ]]; then
  COMMAND="$(python3 "${ROUTER}" "${ROUTE_ARGS[@]}")"
  echo "[model-effort-router] ${COMMAND}" >&2
  [[ -z "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]] || exit 0
fi
# The runner hands single-stage interactive routes straight to the terminal and
# captures two-stage planners before it installs plan.json.
python3 "${ROOT_DIR}/scripts/pipeline.py" --route-file "${ROUTE_FILE}" --cleanup-plan-dir
