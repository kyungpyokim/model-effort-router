#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's real location so the launcher keeps working when it is
# installed elsewhere as a symlink.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  LINK_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${LINK_DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
ROOT_DIR="${MODEL_EFFORT_ROUTER_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
ROUTER="${ROOT_DIR}/scripts/router.py"

if [[ ! -f "${ROUTER}" ]]; then
  echo "codex-route: router not found at ${ROUTER}" >&2
  echo "codex-route: set MODEL_EFFORT_ROUTER_ROOT to the bundle root directory" >&2
  exit 1
fi

INTERACTIVE=0
while [[ "${1:-}" == "--interactive" ]]; do
  INTERACTIVE=1
  shift
done
if [[ "${1:-}" == "--route-file" ]]; then
  [[ "$#" -eq 2 ]] || { echo "usage: codex-route --route-file <route.json>" >&2; exit 2; }
  ROUTE_ARGS=(--route-file "$2")
  COMMAND="$(python3 "${ROUTER}" "${ROUTE_ARGS[@]}")"
  if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}${MODEL_EFFORT_ROUTER_VERBOSE:-}" ]]; then echo "[model-effort-router] ${COMMAND}" >&2; fi
  if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then exit 0; fi
  exec python3 "${ROOT_DIR}/scripts/pipeline.py" --route-file "$2"
fi
if [[ "${1:-}" == "--" ]]; then shift; fi
[[ "$#" -gt 0 ]] || { echo "usage: codex-route [--interactive] -- <task>" >&2; exit 2; }
TASK="$*"
ROUTE_FILE="$(mktemp "${TMPDIR:-/tmp}/model-effort-route.XXXXXX")"
trap 'rm -f "${ROUTE_FILE}"' EXIT
ARGS=("${ROUTER}" "${TASK}" --platform codex --format json)
if [[ "$INTERACTIVE" -eq 1 ]]; then ARGS+=(--interactive); fi
python3 "${ARGS[@]}" > "${ROUTE_FILE}"
ROUTE_ARGS=(--route-file "${ROUTE_FILE}" --cleanup-plan-dir)
COMMAND="$(python3 "${ROUTER}" "${ROUTE_ARGS[@]}")"
if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}${MODEL_EFFORT_ROUTER_VERBOSE:-}" ]]; then echo "[model-effort-router] ${COMMAND}" >&2; fi
if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then exit 0; fi
# The pipeline permits interactive execution only for inspect and gated trivial edits.
python3 "${ROOT_DIR}/scripts/pipeline.py" --route-file "${ROUTE_FILE}" --cleanup-plan-dir
