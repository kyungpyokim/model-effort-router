#!/usr/bin/env bash
set -euo pipefail

# Resolve this script's real location so the launcher keeps working when it is
# installed elsewhere as a symlink.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  LINK_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${LINK_DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
ROOT_DIR="${MODEL_EFFORT_ROUTER_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
ROUTER="${ROOT_DIR}/scripts/router.py"

if [[ ! -f "${ROUTER}" ]]; then
  echo "claude-route: router not found at ${ROUTER}" >&2
  echo "claude-route: set MODEL_EFFORT_ROUTER_ROOT to the bundle root directory" >&2
  exit 1
fi

# On a terminal, default to an interactive executor: `claude -p` cannot edit files
# under default permissions. `--print` forces the non-interactive form.
INTERACTIVE=0
APPROVED=0
if [[ -t 0 && -t 1 ]]; then INTERACTIVE=1; fi
while [[ "${1:-}" == "--interactive" || "${1:-}" == "--print" || "${1:-}" == "--approved" ]]; do
  case "${1}" in
    --interactive) INTERACTIVE=1 ;;
    --print) INTERACTIVE=0 ;;
    --approved) APPROVED=1 ;;
  esac
  shift
done
if [[ "${1:-}" == "--route-file" ]]; then
  [[ "$#" -eq 2 ]] || { echo "usage: claude-route --route-file <route.json>" >&2; exit 2; }
  ROUTE_ARGS=(--route-file "$2")
  if [[ "$APPROVED" -eq 1 ]]; then ROUTE_ARGS+=(--approved); fi
  if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then ROUTE_ARGS+=(--print-only); fi
  COMMAND="$(python3 "${ROUTER}" "${ROUTE_ARGS[@]}")"
  echo "[model-effort-router] ${COMMAND}" >&2
  if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then exit 0; fi
  exec bash -c "${COMMAND}"
fi
[[ "$APPROVED" -eq 0 ]] || { echo "--approved requires --route-file" >&2; exit 2; }
if [[ "${1:-}" == "--" ]]; then shift; fi
[[ "$#" -gt 0 ]] || { echo "usage: claude-route [--interactive] [--approved] -- <task>" >&2; exit 2; }
TASK="$*"
ROUTE_FILE="$(mktemp "${TMPDIR:-/tmp}/model-effort-route.XXXXXX")"
trap 'rm -f "${ROUTE_FILE}"' EXIT
ARGS=("${ROUTER}" "${TASK}" --platform claude-code --format json)
if [[ "$INTERACTIVE" -eq 1 ]]; then ARGS+=(--interactive); fi
python3 "${ARGS[@]}" > "${ROUTE_FILE}"
ROUTE_ARGS=(--route-file "${ROUTE_FILE}")
if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then ROUTE_ARGS+=(--print-only); fi
COMMAND="$(python3 "${ROUTER}" "${ROUTE_ARGS[@]}")"
echo "[model-effort-router] ${COMMAND}" >&2
if [[ -n "${MODEL_EFFORT_ROUTER_PRINT_ONLY:-}" ]]; then exit 0; fi
bash -c "${COMMAND}"
