#!/usr/bin/env python3
"""mer for Claude Code. `mer run "<request>"`: one `claude -p` session with gate, escalation and review.
`mer chat "<request>"`: interactive claude at the routed model/effort. Defaults to --host claude."""
import os
import sys
from pathlib import Path

os.environ["MER_HOST"] = "claude"  # pinned: an exported MER_HOST=codex must not move Claude users (the --host flag still wins)
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from model_effort_router.cli import main

sys.exit(main())
