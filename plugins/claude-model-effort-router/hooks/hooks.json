{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/routing_policy_hook.py\" SessionStart",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
